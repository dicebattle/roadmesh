{
  "name": "routelens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "corpus": "node dist/tools/evaluation_corpus.js",
    "pilot": "node dist/tools/pilot_runner.js",
    "pilot:checks": "node dist/tools/pilot_checks.js",
    "graph:check": "node dist/tools/test_graph.js",
    "simulate": "node dist/tools/vehicle_simulator.js",
    "simulation:check": "node dist/tools/pilot_integration.js",
    "report:serve": "node dist/tools/report_server.js",
    "media:check": "node dist/tools/media_manifest.js",
    "match": "node dist/tools/map_matcher.js",
    "simulation:tiny": "node dist/tools/simulation_checks.js",
    "ingestion:check": "node dist/tools/ingestion_checks.js",
    "ingestion:serve": "node dist/tools/ingestion_service.js",
    "ingestion:worker": "node dist/tools/ingestion_worker.js",
    "aggregation:check": "node dist/tools/aggregation_checks.js",
    "aggregation:worker": "node dist/tools/aggregation_worker.js",
    "publication:check": "node dist/tools/publication_checks.js",
    "publication:worker": "node dist/tools/publication_worker.js",
    "publication:serve": "node dist/tools/publication_service.js",
    "publication:consume": "node dist/tools/publication_consumer_worker.js",
    "traffic:worker": "node dist/tools/traffic_worker.js",
    "traffic:check": "node dist/tools/traffic_checks.js",
    "node:serve": "node dist/tools/node_service.js",
    "node:check": "node dist/tools/node_checks.js",
    "gateway:serve": "node dist/tools/gateway_service.js",
    "gateway:check": "node dist/tools/gateway_checks.js"
  },
  "dependencies": {
    "jose": "6.2.13",
    "jsonc-parser": "3.3.1",
    "pg": "8.23.1",
    "random-js": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
